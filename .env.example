# PostgreSQL + pgvector knowledge database used by docker-compose.yml
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_job_knowledge
POSTGRES_USER=ai_job
POSTGRES_PASSWORD=ai_job_dev_password

# Keep the existing business database configured separately in backend/.env.
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://ai_job:ai_job_dev_password@127.0.0.1:5432/ai_job_knowledge

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=120

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
VECTOR_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
RERANKER_ENABLED=false
RERANKER_PROVIDER=sentence_transformers
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=8
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40
RRF_K=60
VECTOR_CANDIDATE_K=20
KEYWORD_CANDIDATE_K=20
FUSION_CANDIDATE_K=10
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_LLM_ENABLED=false
RAG_CONTEXT_MAX_CHARS=12000
