# ============================================
# 生产环境配置示例
# 复制此文件为 .env 并根据需要修改配置
# ============================================

# 应用配置
APP_ENV=production
APP_DEBUG=false
APP_NAME=AI就业竞争力分析助手
APP_VERSION=1.2.0

# 业务数据库配置（保留原有用户、岗位匹配记录和AI结果表）
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/ai_job_analysis?charset=utf8mb4
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600
DB_ECHO=false

# 知识库专用数据库（必须为 PostgreSQL + pgvector）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_job_knowledge
POSTGRES_USER=ai_job
POSTGRES_PASSWORD=ai_job_dev_password
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://ai_job:ai_job_dev_password@127.0.0.1:5432/ai_job_knowledge

# Embedding / Chunk / Retrieval / RAG
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=120
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
VECTOR_WEIGHT=0.7
KEYWORD_WEIGHT=0.3
RERANKER_ENABLED=false
RAG_CONTEXT_MAX_CHARS=12000

# CORS配置
CORS_ORIGINS=https://your-domain.com

# DeepSeek AI配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT=90
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000

# AI成本控制（每日预算）
AI_COST_BUDGET_PER_DAY=10.0
AI_COST_WARNING_THRESHOLD=0.8

# 限流配置（生产环境建议开启）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)s | %(request_id)s | %(message)s
