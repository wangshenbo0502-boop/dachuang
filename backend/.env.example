# ============================================
# 数据库配置
# MySQL 8.0 数据库连接。请在本地复制为 .env 后填写真实密码。
# ============================================
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/ai_job_analysis?charset=utf8mb4

# 开发阶段如果没有MySQL，可以使用SQLite（取消下面这行注释）
# DATABASE_URL=sqlite:///./ai_job_analysis.db

# ============================================
# CORS 配置
# 允许访问后端 API 的前端地址，多个地址使用英文逗号分隔。
# ============================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# DeepSeek AI 配置
# 请前往 https://platform.deepseek.com/ 获取 API Key
# ============================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# 应用配置
# ============================================
APP_ENV=development
APP_DEBUG=true
