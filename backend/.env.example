# ============================================
# 生产环境配置示例
# 复制此文件为 .env 并根据需要修改配置
# ============================================

# 应用配置
APP_ENV=production
APP_DEBUG=false
APP_NAME=AI就业竞争力分析助手
APP_VERSION=1.2.0

# 数据库配置（生产环境推荐MySQL）
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/ai_job_analysis?charset=utf8mb4
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600
DB_ECHO=false

# CORS配置
CORS_ORIGINS=https://your-domain.com

# DeepSeek AI配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT=90
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000

# AI成本控制（每日预算）
AI_COST_BUDGET_PER_DAY=10.0
AI_COST_WARNING_THRESHOLD=0.8

# 限流配置（生产环境建议开启）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)s | %(request_id)s | %(message)s