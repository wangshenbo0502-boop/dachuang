{
  "_comment": "文件名称：retrieval_config.json | 作用：检索配置，定义检索策略、参数和优先级。",
  "_version": "0.3.0",

  "current_strategy": "keyword",

  "strategies": {
    "keyword": {
      "enabled": true,
      "description": "关键词匹配检索",
      "top_k": 10,
      "score_threshold": 0.0,
      "fields": ["title", "tags", "content"]
    },
    "embedding": {
      "enabled": false,
      "description": "向量相似度检索（未来开启）",
      "top_k": 10,
      "score_threshold": 0.6,
      "model": "bge-m3"
    },
    "hybrid": {
      "enabled": false,
      "description": "混合检索 = 关键词 + 向量融合（未来开启）",
      "keyword_weight": 0.3,
      "embedding_weight": 0.7,
      "top_k": 10
    }
  },

  "reranker": {
    "enabled": false,
    "model": "bge-reranker",
    "top_k": 5,
    "description": "重排序（未来开启）"
  }
}
