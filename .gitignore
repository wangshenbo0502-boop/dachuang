# ============================================
# 文件名称：.gitignore
# 文件作用：Git 版本控制忽略规则，排除不需要提交的文件。
# ============================================

# --- Python ---
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/
*.egg

# --- 本地运行与验收日志 ---
*.log

# --- 环境变量（敏感信息） ---
.env
.env.local
.env.*.local

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 前端 ---
node_modules/
frontend/dist/
frontend/.vite/
admin-frontend/dist/
admin-frontend/.vite/
admin-backend/*.db
admin-backend/*.log

# --- 本地浏览器与验收产物 ---
# 旧版 BOSS 预填功能留下的浏览器登录态（含第三方 cookie）
backend/.boss-browser-profiles/
frontend/.playwright-cli/
frontend/output/

# --- 操作系统 ---
.DS_Store
Thumbs.db
Desktop.ini
*.db
